# Copy this file to .env and fill in your values.
# .env is gitignored and loaded automatically on startup (config.py calls
# load_dotenv()). If you used the double-click installer, it already wrote
# a .env for you and you shouldn't need to touch this file.

# Required — all CDISC Library API calls fail without it.
CDISC_API_KEY=your_cdisc_library_api_key_here

# Optional — a subscription key, when set, is used instead of CDISC_API_KEY
# (sent as the Ocp-Apim-Subscription-Key header).
# CDISC_SUBSCRIPTION_KEY=

# Optional — Flask session secret. Leave unset to use the (insecure) dev
# default; the installer generates a random one for you.
# SECRET_KEY=

# Optional — defaults to a local SQLite file (instance/cdisc_curation.db).
# DATABASE_URL=sqlite:///cdisc_curation.db

# Optional — dev server port, defaults to 8081.
# PORT=8081

# Optional — set to 1 to enable Flask's debugger/auto-reloader. Leave at 0
# (or unset) for a normal end-user install.
# FLASK_DEBUG=0

# Optional — Basic Auth credentials for the NLM Clinical Tables LOINC API.
# Both must be set together; LOINC search works unauthenticated without them.
# LOINC_USER=
# LOINC_PASSWORD=

# Optional — path to the cdisc-bc-ncit-alignment submodule checkout, only
# used by the background NCIt/BC alignment feature. Defaults to
# <app_dir>/cdisc-bc-ncit-alignment.
# ALIGNMENT_SUBMODULE_DIR=
